# Copy this file to .env.local for local development.
# In production, set these in Vercel → Project Settings → Environment Variables.

# --- Supabase (required for admin-editable content: diseases, testimonials) ---
# Find these in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Clinic business details (used in JSON-LD schema for local SEO) ---
# Leave blank to omit that field from schema rather than publish fake data.
NEXT_PUBLIC_CLINIC_EMAIL=
NEXT_PUBLIC_CLINIC_ADDRESS=
NEXT_PUBLIC_CLINIC_PINCODE=
NEXT_PUBLIC_CLINIC_LAT=
NEXT_PUBLIC_CLINIC_LNG=

# --- Social / GBP links (also used in schema "sameAs") ---
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GBP_URL=

# --- Google reviews (only add once verified — do not estimate) ---
NEXT_PUBLIC_GOOGLE_RATING=
NEXT_PUBLIC_GOOGLE_REVIEW_COUNT=
